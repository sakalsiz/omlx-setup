{
  "$schema": "https://opencode.ai/config.json",
  // NOTE: `limit.context` / `limit.output` are OpenCode-side metadata used for
  // token budgeting and auto-compaction. They do NOT change what oMLX allows.
  // These context values are deliberately lower than the server hard ceilings
  // to prevent multi-minute fresh-prefill waits during normal coding.
  // Default model: a ~18 GB MoE 4-bit quant — fits resident in 64 GB next to
  // desktop apps, fast (few active params/token), real tool-calling.
  "model": "omlx/Qwen3.6-35B-A3B-oQ4e-MTP",
  // Route lightweight background work (for example title generation) to the
  // compact ~5.2 GB model instead of waking the main coding model.
  "small_model": "omlx/gemma-4-E4B-it-oQ4e-mtp",
  // Compact before the comfort limit is exhausted and discard stale bulky
  // tool output while preserving the durable session history.
  "compaction": { "auto": true, "prune": true, "reserved": 8192 },
  // Lower-entropy sampling for agentic/tool use: fewer degenerate draws =
  // far lower chance of a non-terminating "runaway" generation. Applied to
  // the interactive agents (build = default TUI agent, plan = plan mode).
  "agent": {
    "build": { "temperature": 0.2, "top_p": 0.9 },
    "plan": { "temperature": 0.2, "top_p": 0.9 }
  },
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        // No API key needed when oMLX runs with skip_api_key_verification
        // (localhost). If you keep verification on: `opencode auth login`.
        // Stall handling: a rare generation can open a stream and produce no
        // tokens. These timeouts convert that infinite freeze into a bounded,
        // resendable error. The slowest retained model decodes at ~21–28 tok/s,
        // so these have comfortable margin and remain a true-stall backstop.
        "timeout": 300000,        // full-request backstop
        "headerTimeout": 120000,  // wait for first response header (cold load + prefill start)
        "chunkTimeout": 90000     // abort if no SSE chunk for 90s
      },
      // oMLX auto-discovers models from its model_dirs and exposes the
      // case-sensitive folder names as IDs — verify yours with:
      //   curl http://127.0.0.1:8000/v1/models
      // Shared rationale: OpenCode context limits are latency-oriented comfort
      // caps below oMLX's per-model max_context_window safety ceilings; see
      // docs/benchmarks/2026-08-30-context.md. The server setting still
      // overrides oMLX's 32k global fallback;
      // output/max_tokens 2048 (bounds runaway generations); temperature 0.2
      // in model `options` because OpenCode drops agent-level temperature for
      // openai-compatible providers (verified on the wire); tool_call
      // advertises function-calling to OpenCode.
      "models": {
        // DEFAULT: MoE oQ4e (~20 GB, oMLX-native imatrix quant) with native
        // MTP head — Lightning MTP measured 85.7 tok/s vs 70.8 off (85% draft
        // acceptance, depth 4). Enable once per model:
        //   PUT /admin/api/models/<id>/settings
        //   {"mtp_enabled": true, "mtp_num_draft_tokens": 4}
        // Replaced Qwen3.6-35B-A3B-OptiQ-4bit (67 tok/s, no MTP head).
        "Qwen3.6-35B-A3B-oQ4e-MTP": {
          "name": "Qwen3.6 35B A3B oQ4e MTP (fits + fastest — default)",
          "tool_call": true,
          // oMLX retains the native 262144 hard ceiling, but a 200k fresh
          // prefill took about seven minutes. The 65k OpenCode comfort cap
          // keeps a cold prefill near 53 seconds; cached incremental turns
          // normally process only the new tail.
          "limit": { "context": 65536, "output": 2048 },
          "options": { "max_tokens": 2048, "temperature": 0.2 }
        },
        // Dense 27B, oQ6e 6-bit mixed with native MTP head (~22 GB). On oMLX
        // 0.6.4 the 6-bit path runs 27.6 tok/s with Lightning MTP — same speed
        // as the 4-bit oQ4e it replaced (28.9), at near-8-bit quality — and
        // co-resides with the MoE default (~43 GB, verified no eviction).
        // Enable MTP per model via: PUT /admin/api/models/<id>/settings
        //   {"mtp_enabled": true, "mtp_num_draft_tokens": 4}
        // Thinking is ON by default in its chat template and think-blocks
        // persist in history (growing prefills) — workable thanks to oMLX's
        // SSD prefix cache + 0.6.4 warm-prefix MTP restoration.
        "Qwen3.8-27B-oQ6e-MTP": {
          "name": "Qwen3.8 27B oQ6e MTP (dense + spec-decode — second opinion)",
          "tool_call": true,
          // oMLX retains its measured 98304 hard ceiling. A 65k fresh prefill
          // took nearly four minutes, while 32k took about 90 seconds, so
          // OpenCode compacts at the smaller daily-use comfort limit.
          "limit": { "context": 32768, "output": 2048 },
          "options": { "max_tokens": 2048, "temperature": 0.2 }
        },
        // Dense 31B general/vision model, oQ4e with native MTP (~19 GB on
        // disk, ~21–27 tok/s). Stronger instruction following than the
        // retired 24B LFM and a useful non-Qwen second opinion.
        "gemma-4-31B-oQ4e-MTP": {
          "name": "Gemma 4 31B oQ4e MTP (dense general + vision)",
          "tool_call": true,
          // oMLX retains its measured 65536 hard ceiling, but a 65k fresh
          // prefill took about 4.4 minutes. The 32k OpenCode comfort cap keeps
          // the corresponding cold wait near 108 seconds.
          "limit": { "context": 32768, "output": 2048 },
          "options": { "max_tokens": 2048, "temperature": 0.2 }
        },
        // Compact dense E4B general/vision model, oQ4e with four native MTP
        // heads (~5.2 GB, ~89 tok/s). Replaces LFM2.5 as the lightweight slot:
        // smaller, aligned, multimodal, and reliable at native tool calls.
        "gemma-4-E4B-it-oQ4e-mtp": {
          "name": "Gemma 4 E4B oQ4e MTP (small + fast + vision)",
          "tool_call": true,
          // oMLX retains the native 131072 ceiling. At 65k this model's cold
          // prefill is still comfortable at about 25 seconds, versus 67
          // seconds at the native maximum.
          "limit": { "context": 65536, "output": 2048 },
          "options": { "max_tokens": 2048, "temperature": 0.2 }
        }
      }
    }
  }
}
